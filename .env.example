# Copy to .env and adjust. .env is git-ignored.
DATABASE_URL=postgresql+psycopg://legal:legal@localhost:5433/legal_docs
LOG_LEVEL=INFO

# demo: try the app with no API key and no cost (a scripted stand-in replaces Claude).
# anthropic: call Claude for real; set ANTHROPIC_API_KEY below. Tests never use either.
LLM_MODE=demo
ANTHROPIC_API_KEY=your-anthropic-api-key
LLM_MODEL=claude-haiku-5-5
LLM_EFFORT=low
